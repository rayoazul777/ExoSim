{
  "version": 3,
  "cmakeMinimumRequired": { "major": 3, "minor": 21, "patch": 0 },
  "configurePresets": [
    {
      "name": "windows-portable",
      "displayName": "Windows portable release (static, no DLLs)",
      "description": "Static vcpkg triplet + static MSVC runtime: the exe runs on a clean Windows machine. Requires the VCPKG_ROOT environment variable.",
      "generator": "Visual Studio 17 2022",
      "architecture": "x64",
      "binaryDir": "${sourceDir}/build/windows-portable",
      "toolchainFile": "$env{VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake",
      "cacheVariables": { "VCPKG_TARGET_TRIPLET": "x64-windows-static" },
      "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Windows" }
    },
    {
      "name": "linux-tests",
      "displayName": "Linux: validation suite only (no GPU/graphics libs)",
      "binaryDir": "${sourceDir}/build/linux-tests",
      "cacheVariables": { "EXOSIM_BUILD_APP": "OFF", "CMAKE_BUILD_TYPE": "Release" },
      "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Linux" }
    },
    {
      "name": "linux-sanitize",
      "inherits": "linux-tests",
      "displayName": "Linux: validation suite under ASan + UBSan",
      "binaryDir": "${sourceDir}/build/linux-sanitize",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo",
        "CMAKE_CXX_FLAGS": "-fsanitize=address,undefined -fno-sanitize-recover=all -fno-omit-frame-pointer"
      }
    }
  ],
  "buildPresets": [
    { "name": "windows-portable", "configurePreset": "windows-portable", "configuration": "Release" },
    { "name": "linux-tests", "configurePreset": "linux-tests" },
    { "name": "linux-sanitize", "configurePreset": "linux-sanitize" }
  ],
  "testPresets": [
    { "name": "windows-portable", "configurePreset": "windows-portable", "configuration": "Release", "output": { "outputOnFailure": true } },
    { "name": "linux-tests", "configurePreset": "linux-tests", "output": { "outputOnFailure": true } },
    { "name": "linux-sanitize", "configurePreset": "linux-sanitize", "output": { "outputOnFailure": true } }
  ]
}
